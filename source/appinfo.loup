@mode(host.dual)

# Application identity and exit statuses of diff. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Constants compiled into the native binary build/diff by
# `make build`; `loup run source/main.loup` and the unit tests (`make test`,
# Stage0) use the same definitions.

pub const APP_NAME: string = "diff";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Compare files line by line (a Loup recreation of GNU diff).";

# Exit statuses returned by main(), as GNU diff defines them.
pub const EXIT_SAME: int = 0;
pub const EXIT_DIFFERENT: int = 1;
pub const EXIT_TROUBLE: int = 2;
