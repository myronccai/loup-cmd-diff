@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "diff";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Compare files line by line (a Loup recreation of GNU diff).";

# Exit statuses returned by main(), as GNU diff defines them.
pub const EXIT_SAME: int = 0;
pub const EXIT_DIFFERENT: int = 1;
pub const EXIT_TROUBLE: int = 2;
