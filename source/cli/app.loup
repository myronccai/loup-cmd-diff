@mode(host.dual)

from appinfo import (APP_NAME, EXIT_SAME, EXIT_TROUBLE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.diff import (run_diff);

# Parses argv, runs diff and returns the exit status: 0 if the inputs are
# the same, 1 if they differ, 2 on trouble (including usage errors).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(i"{$ APP_NAME $}: {$ msg $}");
            printErr(i"{$ APP_NAME $}: Try '{$ APP_NAME $} --help' for more information.");
            return EXIT_TROUBLE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_SAME;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_SAME;
    }

    try {
        return run_diff(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_TROUBLE;
    }
}
