@mode(host.dual)

# Tests for diff's exit statuses, through cli.app.run with whole command
# lines. These tests print the program's normal output and error messages,
# and read tests/fixtures/, so run them from the repository root.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test per
# `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from appinfo import (EXIT_SAME, EXIT_DIFFERENT, EXIT_TROUBLE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_SAME, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["--help"]), EXIT_SAME, "--help");
}

func test_same_files(): void {
    expectEq(run(["tests/fixtures/old.txt", "tests/fixtures/old.txt"]), EXIT_SAME, "same");
}

func test_different_files(): void {
    expectEq(run(["-u", "tests/fixtures/old.txt", "tests/fixtures/new.txt"]), EXIT_DIFFERENT, "different");
}

func test_missing_file_is_trouble(): void {
    expectEq(run(["tests/fixtures/none.txt", "tests/fixtures/old.txt"]), EXIT_TROUBLE, "missing");
}

func test_usage_error_is_trouble(): void {
    expectEq(run(["tests/fixtures/old.txt"]), EXIT_TROUBLE, "one operand");
    expectEq(run(["-k", "a", "b"]), EXIT_TROUBLE, "unknown option");
}
